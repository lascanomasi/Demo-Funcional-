@model List<VotaYa.Models.Pregunta>
@{
    ViewData["Title"] = "Panel Admin";
}

<div class="container mt-4">
    <h2>⚡ Panel de control — VotaYa</h2>

    <div class="card mt-4 mb-4">
        <div class="card-body">
            <h5 class="card-title">Nueva pregunta</h5>
            <form asp-action="CrearPregunta" method="post">
                <div class="mb-3">
                    <label class="form-label">Pregunta</label>
                    <input type="text" name="texto" class="form-control" placeholder="Ej: ¿Cuál es tu serie favorita?" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">Opciones (hasta 4)</label>
                    <input type="text" name="opciones" class="form-control mb-2" placeholder="Opción A" />
                    <input type="text" name="opciones" class="form-control mb-2" placeholder="Opción B" />
                    <input type="text" name="opciones" class="form-control mb-2" placeholder="Opción C" />
                    <input type="text" name="opciones" class="form-control mb-2" placeholder="Opción D" />
                </div>
                <button type="submit" class="btn btn-primary">Crear pregunta</button>
            </form>
        </div>
    </div>

    <h5>Preguntas creadas</h5>
    @foreach (var p in Model)
    {
        <div class="card mb-2 @(p.Activa ? "border-success" : "")">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <strong>@p.Texto</strong>
                    @if (p.Activa)
                    {
                        <span class="badge bg-success ms-2">ACTIVA</span>
                    }
                    <div class="text-muted small">
                        @string.Join(" / ", p.Opciones.Select(o => $"{o.Texto} ({o.Votos})"))
                    </div>
                </div>
                @if (!p.Activa)
                {
                    <form asp-action="Activar" method="post">
                        <input type="hidden" name="id" value="@p.Id" />
                        <button type="submit" class="btn btn-success btn-sm">▶ Activar</button>
                    </form>
                }
            </div>
        </div>
    }

    <div class="mt-4">
        <a href="/Votacion/Resultados" class="btn btn-dark" target="_blank">📊 Ver resultados en vivo</a>
        <a href="/Votacion/Votar" class="btn btn-outline-primary ms-2" target="_blank">🗳️ Ir a votar</a>
    </div>
</div>
